APP_ENV=development
APP_URL=http://localhost:4810
GATEWAY_ADDR=127.0.0.1:4811
GATEWAY_URL=http://127.0.0.1:4811
MYSQL_ROOT_PASSWORD=replace-with-random-password
MYSQL_PASSWORD=replace-with-random-password
MYSQL_DSN=relaypine:replace-with-random-password@tcp(127.0.0.1:4812)/relaypine?parseTime=true&loc=UTC
REDIS_ADDR=127.0.0.1:4813
# Generate with: openssl rand -base64 32
MASTER_KEY=
# Required: your administrator mailbox. Sign-in always verifies an email code.
# All other verified addresses join the waitlist; there is no public signup.
SUPERADMIN_EMAIL=
BOOTSTRAP_NAME=RelayPine Administrator
# Configure a verified Mailgun sending domain. No password or development-code fallback.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM=
MAILGUN_API_BASE=https://api.mailgun.net
# Enable only for explicitly configured local mocks. Forbidden in production.
ALLOW_PRIVATE_UPSTREAMS=false
