APP_ENV=development
APP_URL=http://localhost:4810
GATEWAY_ADDR=127.0.0.1:4811
GATEWAY_URL=http://127.0.0.1:4811
MYSQL_ROOT_PASSWORD=replace-with-random-password
MYSQL_PASSWORD=replace-with-random-password
MYSQL_DSN=relaypine:replace-with-random-password@tcp(127.0.0.1:4812)/relaypine?parseTime=true&loc=UTC
REDIS_ADDR=127.0.0.1:4813
# Generate with: openssl rand -base64 32
MASTER_KEY=
# Used only to initialize the first operator, no customer balance is granted.
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
BOOTSTRAP_NAME=RelayPine Operator
# Enable only for explicitly configured local mocks. Forbidden in production.
ALLOW_PRIVATE_UPSTREAMS=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=2026-04-22.dahlia
