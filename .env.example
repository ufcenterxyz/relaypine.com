APP_ENV=development
APP_URL=http://localhost:4810
ADMIN_APP_URL=http://admin.localhost:4810
GATEWAY_ADDR=127.0.0.1:4811
GATEWAY_URL=http://127.0.0.1:4811
MYSQL_ROOT_PASSWORD=replace-with-random-password
MYSQL_PASSWORD=replace-with-random-password
MYSQL_DSN=relaypine:replace-with-random-password@tcp(127.0.0.1:4812)/relaypine?parseTime=true&loc=UTC
REDIS_ADDR=127.0.0.1:4813
# Generate with: openssl rand -base64 32
MASTER_KEY=
# Required: your administrator mailbox. Sign-in always verifies an email code.
# Other verified addresses receive an isolated customer workspace with zero balance.
SUPERADMIN_EMAIL=
BOOTSTRAP_NAME=RelayPine Administrator
# Configure a verified Mailgun sending domain. No password or development-code fallback.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM=
MAILGUN_API_BASE=https://api.mailgun.net
# Enable only for explicitly configured local mocks. Forbidden in production.
ALLOW_PRIVATE_UPSTREAMS=false
# Encrypted request and response bodies for the console's request details.
# Leave the retention empty to keep them indefinitely, or set 1-3650 to delete
# bodies older than that many days.
REQUEST_BODY_CAPTURE=true
REQUEST_BODY_RETENTION_DAYS=
# Optional S3-compatible object storage for request bodies (COS, S3, R2, MinIO).
# Leave all empty to keep bodies in MySQL; otherwise set all five.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
# true for MinIO and other services that need the bucket in the URL path.
OBJECT_STORAGE_PATH_STYLE=false
